{
  "name": "resq-box",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/cek-env.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "cek:env": "node scripts/cek-env.mjs",
    "test": "node --test --experimental-strip-types \"src/**/__tests__/*.test.ts\"",
    "test:sql": "python supabase/validate_sql.py && python supabase/validate_plpgsql_vars.py",
    "test:isolation": "node supabase/test_isolation.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.116.0",
    "@types/three": "^0.186.0",
    "@types/uuid": "^10.0.0",
    "@xyflow/react": "^12.10.2",
    "blockly": "^12.5.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "motion": "^13.4.0",
    "page-flip": "^2.0.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-pageflip": "^2.0.3",
    "react-router-dom": "^7.15.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.1",
    "uuid": "^14.0.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0"
  }
}
