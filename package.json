{
  "name": "resq-box",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/cek-env.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "cek:env": "node scripts/cek-env.mjs",
    "test": "node --test --experimental-strip-types \"src/**/__tests__/*.test.ts\"",
    "test:sql": "python supabase/validate_sql.py && python supabase/validate_plpgsql_vars.py",
    "test:isolation": "node supabase/test_isolation.mjs",
    "cek:pendaftaran": "node supabase/cek_pendaftaran.mjs",
    "cek:keamanan": "python scripts/audit_keamanan.py",
    "diagnosa:akun": "node supabase/diagnosa_akun.mjs",
    "cek:kolom": "python scripts/audit_kolom_dibuang.py",
    "cek:semua": "npm run cek:keamanan && npm run cek:akses-publik && npm run cek:kebocoran && npm run cek:kolom && npm run cek:gerbang-level && npm run cek:safe-area && npm run cek:responsif && npm run cek:animasi && npm run cek:petunjuk-hp && npm run cek:tata-letak && npm run cek:panduan && npm run cek:pendaftaran && npm run test:mode-tamu && npm run test:lingkungan",
    "test:pesan-galat": "node scripts/uji_pesan_galat.mjs",
    "cek:kebocoran": "python scripts/audit_kebocoran.py",
    "hitung:beban": "python scripts/hitung_beban.py",
    "uji:beban": "node scripts/uji_beban.mjs",
    "test:pakaian": "node scripts/uji_pakaian_teleport.mjs",
    "cek:panduan": "python scripts/periksa_selector_panduan.py",
    "test:level-guru": "node scripts/uji_level_guru.mjs",
    "cek:gerbang-level": "python scripts/periksa_gerbang_level.py",
    "android:sync": "npm run build && cap sync android && node scripts/siapkan-aset-android.mjs",
    "android:open": "cap open android",
    "android:build": "npm run android:sync && cap build android",
    "test:nilai-luring": "node scripts/uji_nilai_luring.mjs",
    "cek:tata-letak": "python scripts/periksa_tata_letak.py",
    "cek:safe-area": "python scripts/periksa_safe_area.py",
    "desktop": "electron electron/main.cjs",
    "desktop:build": "node scripts/bangun_desktop.mjs",
    "desktop:uji-server": "node scripts/uji_server_desktop.mjs",
    "cek:responsif": "python scripts/periksa_responsif.py",
    "ganti:dvh": "python scripts/ganti_ke_dvh.py",
    "cek:akses-publik": "python scripts/uji_akses_tanpa_login.py",
    "test:mode-tamu": "node scripts/uji_mode_tamu.mjs",
    "test:lingkungan": "node scripts/uji_lingkungan.mjs",
    "cek:petunjuk-hp": "python scripts/periksa_petunjuk_hp.py",
    "cek:izin-guru": "python scripts/periksa_izin_guru.py",
    "uji:isolasi-guru": "python scripts/uji_isolasi_guru.py",
    "guru:buat": "python scripts/kelola_akun_guru.py buat",
    "guru:periksa": "python scripts/kelola_akun_guru.py periksa",
    "guru:daftar": "python scripts/kelola_akun_guru.py daftar",
    "guru:ganti-sandi": "python scripts/kelola_akun_guru.py ganti-sandi"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@supabase/supabase-js": "^2.116.0",
    "@types/three": "^0.186.0",
    "@types/uuid": "^10.0.0",
    "blockly": "^12.5.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "three": "^0.186.1",
    "uuid": "^14.0.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "id.resqbox.desktop",
    "productName": "RESQ-BOX",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "RESQ-BOX-${version}-portable.exe"
    },
    "portable": {
      "artifactName": "RESQ-BOX-${version}-portable.exe",
      "unicode": true
    },
    "compression": "normal",
    "asar": true
  }
}
